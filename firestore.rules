rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // حالة إيقاف الموقع: القراءة للجميع، والكتابة للإدارة فقط (غيّر البريد)
    match /db/ctl {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ضع_بريد_الإدارة_هنا';
    }
    match /db/main {
      allow read, write: if request.auth != null;
    }
  }
}
